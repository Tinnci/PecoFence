{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local welcome hub reads, validated navigation and owner-run SPM discovery, drafts and template import; caption buttons and dragging for the undecorated window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-load-hub",
    "allow-launch-target",
    "allow-first-frame",
    "allow-template-plan",
    "allow-template-apply",
    "allow-project-status",
    "allow-connections",
    "allow-logging-settings",
    "allow-calendar-settings",
    "allow-connection-sign-in",
    "allow-discover",
    "allow-draft",
    "allow-activate",
    "allow-service-status",
    "allow-remap",
    "allow-focus",
    "allow-save-png",
    "allow-client-error",
    "allow-show-main",
    "allow-project-change",
    "allow-backup-export",
    "allow-backup-plan",
    "allow-backup-apply",
    "core:app:allow-version",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    },
    "clipboard-manager:allow-write-text",
    "opener:allow-reveal-item-in-dir"
  ]
}
