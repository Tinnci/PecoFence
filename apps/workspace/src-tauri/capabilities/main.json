{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local welcome hub reads, validated navigation and owner-run SPM discovery, drafts and template import",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-load-hub",
    "allow-launch-target",
    "allow-first-frame",
    "allow-template-plan",
    "allow-template-apply",
    "allow-project-status",
    "allow-connections",
    "allow-connection-sign-in",
    "allow-discover",
    "allow-draft",
    "allow-activate",
    "allow-service-status",
    "allow-remap",
    "allow-focus"
  ]
}
