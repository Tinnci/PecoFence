# Normalize line endings across Windows/WSL development
* text=auto

# Force LF for cross-platform scripts and sources
*.rs text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
third_party/winappsdk/app.manifest text eol=lf
third_party/winappsdk/runtime.txt text eol=lf
# Keep upstream CRLF and blank lines byte-exact; the runtime tests verify its hash.
third_party/winappsdk/WINDOWS-APP-SDK-LICENSE.txt -text -whitespace

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.bat text eol=crlf

# Binaries
*.png binary
*.ico binary
*.jpg binary
*.woff binary
*.woff2 binary
